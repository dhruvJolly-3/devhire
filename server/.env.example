# Copy to server/.env and fill in real values. Never commit the filled-in file.

PORT=5001

# MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devhire?appName=Cluster0

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Comma-separated list of browser origins allowed to call this API.
# Local dev origins are always allowed; add production origins here.
CORS_ORIGINS=https://your-project.vercel.app

# Anthropic API key for the AI match score and cover-letter features.
# Optional: without it the rest of the app works and the AI routes return 503.
ANTHROPIC_API_KEY=

# Live job import (services/jobSync.js). Runs at startup and every N minutes.
# JOB_SYNC=off disables it. JOB_SOURCES: any of adzuna,greenhouse,remotive,arbeitnow.
JOB_SYNC_MINUTES=30
JOB_SOURCES=adzuna,greenhouse

# Adzuna India — the main job source (free key: https://developer.adzuna.com
# → Register → Dashboard). Fetched every ADZUNA_EVERY_MINUTES (default 180)
# to stay inside the free quota.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: official Greenhouse career-page feeds, "board:Company Name,...".
# Find a board name in a company's careers URL: boards.greenhouse.io/<board>
GREENHOUSE_BOARDS=
