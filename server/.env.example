# Copy to server/.env and fill in real values. Never commit the filled-in file.

PORT=5001

# MongoDB Atlas connection string.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/devhire?appName=Cluster0

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Comma-separated list of browser origins allowed to call this API.
# Local dev origins are always allowed; add production origins here.
CORS_ORIGINS=https://your-project.vercel.app
