# Frontend environment. Copy to .env.local for local overrides.
# Vite only exposes variables prefixed with VITE_ to the browser —
# never put secrets here, they ship in the JS bundle.

# Base URL of the deployed backend, including the /api suffix.
# Leave unset locally to use http://localhost:5001/api.
VITE_API_URL=https://your-api.onrender.com/api
